# Source files (only include dist in published package)
src/
tsconfig.json
*.tsbuildinfo

# Development files
.github/
docs/
.vscode/
.idea/

# Test files
**/*.test.ts
**/*.spec.ts
**/__tests__/
coverage/

# Development dependencies
node_modules/
yarn.lock
package-lock.json

# Environment and config files
.env*
.editorconfig
.eslintrc*
.prettierrc*

# Build artifacts that shouldn't be published
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db

# Temporary files
*.tmp
*.swp
*.swo

# Git files
.git/
.gitignore